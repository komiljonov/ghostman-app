# Wails build output. The rest of build/ (icons, manifests, installer
# scripts) is project config that Wails expects to be committed.
build/bin/

# Frontend
node_modules/
.task/
# Wails caches the package.json hash here to skip redundant npm installs.
frontend/package.json.md5
# Vite output — only the placeholder is tracked, so `//go:embed all:frontend/dist`
# compiles in a fresh clone (go test / lint) before the frontend is built.
frontend/dist/*
!frontend/dist/gitkeep
# frontend/wailsjs/ is intentionally committed: it's regenerated by wails dev/build,
# but tsc (task frontend:check) and editors need it without running Wails first.

# Local databases
*.db
*.db-shm
*.db-wal

# Editors / OS
.idea/
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
!.vscode/extensions.json
.DS_Store
Thumbs.db
