package main

import (
	"fmt"
	"io"
	"net/http"
)

func main() {
	// JWT: <signed at send time>
	req, err := http.NewRequest("GET", "https://api.example.com/me", nil)
	if err != nil {
		panic(err)
	}
	req.Header.Add("Authorization", "Bearer <signed at send time>")
	client := &http.Client{}
	resp, err := client.Do(req)
	if err != nil {
		panic(err)
	}
	defer resp.Body.Close()
	out, err := io.ReadAll(resp.Body)
	if err != nil {
		panic(err)
	}
	fmt.Println(resp.Status)
	fmt.Println(string(out))
}
