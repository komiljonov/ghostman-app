package main

import (
	"fmt"
	"io"
	"net/http"
)

func main() {
	// pre/post scripts are not represented
	// sent through the proxy Local squid (http://localhost:3128) — not represented in this snippet
	// the proxy needs credentials (stored on this machine only, never in snippets)
	req, err := http.NewRequest("GET", "https://api.example.com/%7B%7Bunresolved%7D%7D", nil)
	if err != nil {
		panic(err)
	}
	client := &http.Client{}
	resp, err := client.Do(req)
	if err != nil {
		panic(err)
	}
	defer resp.Body.Close()
	out, err := io.ReadAll(resp.Body)
	if err != nil {
		panic(err)
	}
	fmt.Println(resp.Status)
	fmt.Println(string(out))
}
