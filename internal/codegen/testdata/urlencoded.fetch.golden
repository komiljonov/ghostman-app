const response = await fetch("https://api.example.com/login", {
  method: "POST",
  headers: {
    "Content-Type": "application/x-www-form-urlencoded",
  },
  body: new URLSearchParams([
    ["user", "a b&c=d"],
    ["pass", "p'w\"$"],
    ["user", "second"],
  ]),
});
console.log(response.status, await response.text());
