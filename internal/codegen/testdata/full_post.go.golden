package main

import (
	"context"
	"fmt"
	"io"
	"net/http"
	"strings"
	"time"
)

func main() {
	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
	defer cancel()
	req, err := http.NewRequestWithContext(ctx, "POST", "https://api.example.com/items?existing=1&tag=a&tag=b+c", strings.NewReader("{\"name\": \"it's \\\"quoted\\\"\", \"cost\": \"$HOME ${PATH} $(whoami) `id`\",\n\"path\": \"C:\\\\temp\\\\x\", \"tab\":\"\t\", \"crlf\": \"a\r\nb\",\n\"uni\": \"üñí ✓ 😀 \u2028\"}\n"))
	if err != nil {
		panic(err)
	}
	req.Header.Add("X-Trace", "abc")
	req.Header.Add("X-Empty", "")
	req.Header.Add("Accept", "application/json")
	req.Header.Add("Authorization", "Bearer tok-123")
	req.Header.Add("Content-Type", "application/json")
	client := &http.Client{}
	resp, err := client.Do(req)
	if err != nil {
		panic(err)
	}
	defer resp.Body.Close()
	out, err := io.ReadAll(resp.Body)
	if err != nil {
		panic(err)
	}
	fmt.Println(resp.Status)
	fmt.Println(string(out))
}
