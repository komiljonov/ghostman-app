package main

import (
	"bytes"
	"fmt"
	"io"
	"mime/multipart"
	"net/http"
	"os"
)

func main() {
	// file paths are placeholders (template values)
	var buf bytes.Buffer
	mw := multipart.NewWriter(&buf)
	if err := mw.WriteField("title", "@not-a-file <neither"); err != nil {
		panic(err)
	}
	{
		f, err := os.Open("<path to avatar.png>")
		if err != nil {
			panic(err)
		}
		fw, err := mw.CreateFormFile("avatar", "avatar.png")
		if err != nil {
			panic(err)
		}
		if _, err := io.Copy(fw, f); err != nil {
			panic(err)
		}
		f.Close()
	}
	if err := mw.Close(); err != nil {
		panic(err)
	}
	req, err := http.NewRequest("POST", "https://api.example.com/upload", &buf)
	if err != nil {
		panic(err)
	}
	req.Header.Set("Content-Type", mw.FormDataContentType())
	client := &http.Client{}
	resp, err := client.Do(req)
	if err != nil {
		panic(err)
	}
	defer resp.Body.Close()
	out, err := io.ReadAll(resp.Body)
	if err != nil {
		panic(err)
	}
	fmt.Println(resp.Status)
	fmt.Println(string(out))
}
